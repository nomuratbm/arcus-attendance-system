AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
DYNAMODB_TABLE_NAME=""

# Amazon Cognito — traditional web app (confidential client with secret)
# Register these exact URLs on the app client:
#   Allowed callback URL:  {APP_BASE_URL}/api/auth/callback
#   Allowed sign-out URL:  {APP_BASE_URL}/
# Use the authorization code grant. Do not expose COGNITO_CLIENT_SECRET to the browser.
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_CLIENT_SECRET=""
# Hosted UI / managed login host only, e.g. my-app.auth.ap-southeast-1.amazoncognito.com
COGNITO_DOMAIN=""
# Cognito user pool group required for /scanner, /addevent, and admin APIs
COGNITO_ADMIN_GROUP=""
APP_BASE_URL="http://localhost:3000"
